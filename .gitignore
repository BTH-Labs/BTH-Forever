# Exclude exported CurseForge zip files
*.zip

# Exclude exported Modrinth modpacks
*.mrpack

# Exclude .direnv
.direnv

# Eclude precommit hooks config
.pre-commit-config.yaml

# Exclude the generated packwiz index (regenerated by `packwiz refresh`).
# Keeping it out of version control prevents merge conflicts when mods are
# added in parallel. See the README.
BTH-Forever/index.toml

# Exclude IDE paths
.idea/
